# Общие (подключение с хоста к compose — внешние порты 12xxx)
POSTGRES_HOST=localhost
POSTGRES_PORT=12432
POSTGRES_DB=monitoring_db
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin_password
REDIS_HOST=localhost
REDIS_PORT=12679
DATA_DIR=/data

# core-api (внутри контейнера порт 3000; с хоста — 12300)
PORT=3000
PIPELINE_CONFIG_PATH=/app/config/pipeline.json
MIGRATIONS_DIR=/app/migrations
CACHE_TTL_SECONDS=604800
SERVICE_TIMEOUT_MS=15000
SERVICE_RETRY_BASE_DELAY_MS=5000
SERVICE_RETRY_MAX_DELAY_MS=300000
DISPATCH_INTERVAL_MS=1000
DISPATCH_LEASE_MS=60000
DISPATCH_RETRY_DELAY_MS=5000
ORCHESTRATOR_CONCURRENCY=10
DETECTION_CRON=0 3 * * *
ANALYSIS_CRON=0 4 * * *
DETECTION_TZ=Europe/Moscow

# detecting (с хоста — 12800)
DETECTING_PORT=8000
DETECTING_REDIS_HOST=redis
DETECTING_DATA_DIR=/data
DETECTING_WEIGHTS_DIR=/weights
DETECTING_CACHE_DIR=/cache

# planning (с хоста — 12801)
PLANNING_PORT=8001
PLANNING_REDIS_HOST=redis
PLANNING_DATA_DIR=/data
PLANNING_POSTGRES_HOST=db
PLANNING_POSTGRES_PORT=5432
PLANNING_POSTGRES_DB=monitoring_db
PLANNING_POSTGRES_USER=admin
PLANNING_POSTGRES_PASSWORD=admin_password
PLANNING_NORMALIZE_ENABLED=false
PLANNING_RERANK_ENABLED=false
PLANNING_CACHE_DIR=/cache
PLANNING_LLM_URL=https://polza.ai/api/v1/chat/completions
PLANNING_LLM_TOKEN=
PLANNING_LLM_MODEL=openai/gpt-4.1-nano

# analysis (с хоста — 12802)
ANALYSIS_PORT=8002
ANALYSIS_REDIS_HOST=redis
ANALYSIS_POSTGRES_HOST=db
ANALYSIS_POSTGRES_PORT=5432
ANALYSIS_POSTGRES_DB=monitoring_db
ANALYSIS_POSTGRES_USER=admin
ANALYSIS_POSTGRES_PASSWORD=admin_password
ANALYSIS_PERSON_GAP_ENABLED=false
ANALYSIS_MIN_FRAMES_GOOD=8
ANALYSIS_MIN_CAMERAS_GOOD=2
ANALYSIS_MIN_HOUR_SPAN_GOOD=2
ANALYSIS_GAP_DAYS_THRESHOLD=2
